# DOGE Grid Trading Bot Configuration
# Copy this file to .env and update with your values

# =============================================================================
# TRADING CONFIGURATION
# =============================================================================

# Trading mode: LIVE for real trading, PAPER for simulation
MODE=PAPER

# Binance region: 'com' for international, 'us' for US customers
BINANCE_REGION=com

# Trading pair (currently optimized for DOGE/USDT)
PAIR=DOGE/USDT

# =============================================================================
# API CREDENTIALS
# =============================================================================

# Option 1: Combined API keys (legacy)
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Option 2: Separate trading keys (recommended for security)
# BINANCE_TRADE_KEY=your_trade_key_here
# BINANCE_TRADE_SECRET=your_trade_secret_here
# BINANCE_READ_KEY=your_read_key_here
# BINANCE_READ_SECRET=your_read_secret_here

# =============================================================================
# GRID TRADING PARAMETERS
# =============================================================================

# Grid price boundaries (in USDT for DOGE/USDT)
GRID_LOW=0.13
GRID_HIGH=0.32

# Alternative names for compatibility
GRID_MIN=0.13
GRID_MAX=0.32

# Step percentage between grid levels (1.0 = 1%)
STEP_PCT=1.0
GRID_STEP_PCT=1.0

# Base order size in USD
BASE_ORDER_USD=5.0

# Maximum USD to invest per cycle
MAX_CYCLE_USD=1000.0
MAX_USD_FOR_CYCLE=1000.0

# =============================================================================
# ADVANCED SETTINGS
# =============================================================================

# API request timeout window (milliseconds)
BINANCE_RECVWINDOW=10000

# Bot polling interval (seconds)
POLL_SECONDS=30

# Profit splitting configuration
SPLIT_TRIGGER_ENV=0.05
SPLIT_CHUNK_USD=100.0

# =============================================================================
# OPTIONAL FEATURES
# =============================================================================

# Telegram notifications (optional)
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id

# Custom data directory (optional)
# DATA_DIR=/path/to/custom/data/directory

# Dashboard configuration
# DASH_HOST=127.0.0.1
# DASH_PORT=8899

# =============================================================================
# DEVELOPMENT/TESTING
# =============================================================================

# Enable debug logging
# DEBUG=true

# Custom state file location
# STATE_FILE=./custom_state.json

# Fee buffer for calculations (default: 0.001 = 0.1%)
# FEE_BUFFER=0.001